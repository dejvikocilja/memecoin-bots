{
  "name": "memecoin-bots",
  "version": "0.0.0",
  "private": true,
  "description": "Paper-first memecoin trading bots: pluggable strategies, risk profiles and an independent risk manager. Personal use only; not financial advice.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check": "pnpm check:secrets && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:engine": "pnpm --filter @memebots/engine dev",
    "dev:market-data": "pnpm --filter @memebots/market-data collect",
    "dev:api": "pnpm --filter @memebots/api dev",
    "dev:dashboard": "pnpm --filter @memebots/dashboard dev",
    "db:migrate": "pnpm --filter @memebots/db migrate up",
    "db:rollback": "pnpm --filter @memebots/db migrate down",
    "db:status": "pnpm --filter @memebots/db migrate status",
    "monitor": "pnpm --filter @memebots/engine monitor",
    "wallet": "pnpm --filter @memebots/db wallet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
