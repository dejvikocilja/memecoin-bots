# Copy to .env and fill in. Never commit .env (it is git-ignored and CI checks for it).
# The typed config loader from BOT-4 will validate these at startup.

# off | paper | live. Defaults to paper; live is refused until live trading is built.
BOT_MODE=paper

# API (listens on loopback only by default)
API_HOST=127.0.0.1
API_PORT=3001

# PostgreSQL (see docker-compose.yml, or a local install)
DATABASE_URL=postgres://memebots:memebots@127.0.0.1:5432/memebots
# Disposable database for `pnpm test`. Its name must end in _test: the tests wipe it.
TEST_DATABASE_URL=postgres://memebots:memebots@127.0.0.1:5432/memebots_test

# Solana RPC. Free public endpoint by default (ADR-1); rate limits apply.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Telegram alerts (BOT-26). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Wallet keys are NOT set here in plain text. BOT-4 defines how encrypted keys are loaded.
