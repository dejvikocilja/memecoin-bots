# Non-secret local defaults. Never put real wallet keys/API credentials in this file.
BOT_MODE=paper
BOT_MARKET_DATA=fixtures
API_HOST=127.0.0.1
API_PORT=3001
# Demo-only credentials match docker-compose.yml; use an encrypted source for real credentials.
DATABASE_URL=postgresql://memebots:memebots@127.0.0.1:5432/memebots
# Disposable database for `pnpm test` (BOT-5). Its name must end in _test: the tests wipe it.
TEST_DATABASE_URL=postgresql://memebots:memebots@127.0.0.1:5432/memebots_test
BOT_MONTHLY_SERVICE_BUDGET_USD=0
BOT_HELIUS_MONTHLY_CREDIT_STOP=800000
BOT_JUPITER_REQUESTS_PER_MINUTE=20
BOT_WATCHLIST_SIZE=10
BOT_SNAPSHOT_INTERVAL_MS=30000
BOT_MAX_DATA_AGE_MS=60000
# Inject HELIUS_API_KEY from a protected environment/secret manager for mainnet read-only data.
# Optional JUPITER_API_KEY must also come from a protected source. Keyless is the default.
# Alternatively inject BOT_ENCRYPTED_CONFIG plus BOT_CONFIG_ENCRYPTION_KEY (see docs/configuration.md).
# Wallet private keys and live mode are rejected until the live executor is implemented.

# Independent opt-in read-only discovery; fixture polling mode needs no Helius key.
MARKET_DATA_ENABLED=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# BOT-7 read-only collector: disabled until explicitly configured.
# DEX Screener needs no API key. Start with <=10 allowlisted mints (ADR-1).
MARKET_DATA_SOURCE=off
TRACKED_TOKEN_MINTS=
# Use a separate disposable database: BOT-5 tests wipe TEST_DATABASE_URL's schema.
MARKET_DATA_TEST_DATABASE_URL=postgresql://memebots:memebots@127.0.0.1:5432/market_feed_test
