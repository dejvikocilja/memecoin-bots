{
  "name": "@memebots/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API for the dashboard (Fastify). Scaffold only: a health endpoint.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@memebots/source src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@memebots/core": "workspace:*",
    "fastify": "^5.12.7",
    "@memebots/config": "workspace:*"
  }
}
