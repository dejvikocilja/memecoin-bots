{
  "name": "@memebots/engine",
  "version": "0.0.0",
  "private": true,
  "description": "The bot engine: market data in, strategies, risk manager, executor. Scaffold only; starts in paper mode.",
  "type": "module",
  "exports": {
    ".": {
      "@memebots/source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@memebots/source src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@memebots/core": "workspace:*",
    "@memebots/config": "workspace:*"
  }
}
